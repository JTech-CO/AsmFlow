{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asmflow.example/schema/asmflow.schema.json",
  "title": "AsmFlow configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "listener",
    "control",
    "storage",
    "logging",
    "limits",
    "providers",
    "routes",
    "mcp_servers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "listener": {
      "$ref": "#/$defs/listener"
    },
    "control": {
      "$ref": "#/$defs/control"
    },
    "storage": {
      "$ref": "#/$defs/storage"
    },
    "logging": {
      "$ref": "#/$defs/logging"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "providers": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/provider"
      }
    },
    "routes": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "mcp_servers": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/mcpServer"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "envName": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]*$",
      "maxLength": 128
    },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "name"
      ],
      "properties": {
        "source": {
          "const": "env"
        },
        "name": {
          "$ref": "#/$defs/envName"
        }
      }
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "env"
          ],
          "properties": {
            "type": {
              "const": "bearer_env"
            },
            "env": {
              "$ref": "#/$defs/envName"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "header",
            "value"
          ],
          "properties": {
            "type": {
              "const": "header_env"
            },
            "header": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,64}$"
            },
            "value": {
              "$ref": "#/$defs/secretRef"
            }
          }
        }
      ]
    },
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "auth",
        "request_header_max_bytes",
        "request_body_max_bytes",
        "idle_timeout_ms"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "request_header_max_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 1048576
        },
        "request_body_max_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "idle_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        "expose_unavailable_models": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "socket_path",
        "mode",
        "frame_max_bytes"
      ],
      "properties": {
        "socket_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "mode": {
          "enum": [
            "0600"
          ]
        },
        "frame_max_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 4194304
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_path",
        "journal_mode",
        "busy_timeout_ms",
        "request_metadata_retention_days",
        "store_payloads"
      ],
      "properties": {
        "database_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "journal_mode": {
          "const": "wal"
        },
        "busy_timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "request_metadata_retention_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        },
        "store_payloads": {
          "type": "boolean"
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "format",
        "destination",
        "include_request_metadata",
        "include_payloads",
        "redact_headers"
      ],
      "properties": {
        "level": {
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error",
            "fatal"
          ]
        },
        "format": {
          "enum": [
            "jsonl",
            "text"
          ]
        },
        "destination": {
          "enum": [
            "stderr",
            "file"
          ]
        },
        "file_path": {
          "type": "string",
          "maxLength": 4096
        },
        "include_request_metadata": {
          "type": "boolean"
        },
        "include_payloads": {
          "type": "boolean"
        },
        "redact_headers": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "destination": {
                "const": "file"
              }
            }
          },
          "then": {
            "required": [
              "file_path"
            ]
          }
        }
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_active_requests",
        "max_queued_requests",
        "json_max_depth",
        "json_string_max_bytes",
        "sse_event_max_bytes",
        "mcp_frame_max_bytes",
        "stderr_line_max_bytes"
      ],
      "properties": {
        "max_active_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "max_queued_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "json_max_depth": {
          "type": "integer",
          "minimum": 4,
          "maximum": 256
        },
        "json_string_max_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "sse_event_max_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        },
        "mcp_frame_max_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "stderr_line_max_bytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 1048576
        }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connect_ms",
        "request_ms",
        "idle_stream_ms"
      ],
      "properties": {
        "connect_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 600000
        },
        "request_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        },
        "idle_stream_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responses",
        "chat_completions",
        "streaming",
        "tools",
        "vision",
        "json_schema"
      ],
      "properties": {
        "responses": {
          "type": "boolean"
        },
        "chat_completions": {
          "type": "boolean"
        },
        "streaming": {
          "type": "boolean"
        },
        "tools": {
          "type": "boolean"
        },
        "vision": {
          "type": "boolean"
        },
        "json_schema": {
          "type": "boolean"
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "interval_ms",
        "failure_threshold",
        "success_threshold",
        "open_cooldown_ms"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 512
        },
        "interval_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        "failure_threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "success_threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "open_cooldown_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "adapter",
        "base_url",
        "auth",
        "enabled",
        "required",
        "max_concurrency",
        "timeouts",
        "capabilities",
        "health"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "adapter": {
          "enum": [
            "openai_responses",
            "openai_chat",
            "openai_dual"
          ]
        },
        "base_url": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 2048
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "enabled": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "timeouts": {
          "$ref": "#/$defs/timeouts"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "health": {
          "$ref": "#/$defs/health"
        },
        "allow_insecure_private_http": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "max_attempts",
        "retryable"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "retryable": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": {
            "enum": [
              "connect_failed",
              "dns_failed",
              "connect_timeout",
              "http_502",
              "http_503",
              "http_504"
            ]
          }
        }
      }
    },
    "routeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "upstream_model",
        "priority",
        "weight"
      ],
      "properties": {
        "provider_id": {
          "$ref": "#/$defs/id"
        },
        "upstream_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "priority": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "model_alias",
        "enabled",
        "endpoint_families",
        "policy",
        "fallback",
        "targets"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "model_alias": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "enabled": {
          "type": "boolean"
        },
        "endpoint_families": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "responses",
              "chat_completions"
            ]
          }
        },
        "policy": {
          "enum": [
            "priority",
            "round_robin",
            "least_latency"
          ]
        },
        "fallback": {
          "$ref": "#/$defs/fallback"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/routeTarget"
          }
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred",
        "legacy"
      ],
      "properties": {
        "preferred": {
          "enum": [
            "2026-07-28"
          ]
        },
        "legacy": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "2025-11-25"
            ]
          }
        }
      }
    },
    "restart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "max_restarts",
        "window_ms",
        "backoff_ms",
        "max_backoff_ms"
      ],
      "properties": {
        "mode": {
          "enum": [
            "never",
            "on_failure",
            "always"
          ]
        },
        "max_restarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "window_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        },
        "backoff_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "max_backoff_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      }
    },
    "mcpStdio": {
      "type": "object",
      "$comment": "env_allow and env property names must be disjoint. Draft 2020-12 cannot compare dynamic array values with dynamic object keys, so the schema-equivalent reference and NASM validators enforce this cross-field rule.",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "transport",
        "enabled",
        "required",
        "command",
        "args",
        "cwd",
        "env_allow",
        "env",
        "protocol",
        "restart",
        "startup_timeout_ms",
        "shutdown_grace_ms"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "transport": {
          "const": "stdio"
        },
        "enabled": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "command": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$",
          "maxLength": 4096
        },
        "args": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000]*$",
            "maxLength": 4096
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]*$",
          "maxLength": 4096
        },
        "env_allow": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/envName"
          }
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/envName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/secretRef"
          },
          "maxProperties": 128
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "restart": {
          "$ref": "#/$defs/restart"
        },
        "startup_timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 600000
        },
        "shutdown_grace_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      }
    },
    "mcpHttp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "transport",
        "enabled",
        "required",
        "url",
        "auth",
        "protocol",
        "timeouts"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "transport": {
          "const": "streamable_http"
        },
        "enabled": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 2048
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "timeouts": {
          "$ref": "#/$defs/timeouts"
        },
        "allow_insecure_private_http": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "mcpServer": {
      "oneOf": [
        {
          "$ref": "#/$defs/mcpStdio"
        },
        {
          "$ref": "#/$defs/mcpHttp"
        }
      ]
    }
  }
}
