{
  "schema_version": 1,
  "listener": {
    "host": "127.0.0.1",
    "port": 8080,
    "auth": {
      "type": "none"
    },
    "request_header_max_bytes": 65536,
    "request_body_max_bytes": 8388608,
    "idle_timeout_ms": 30000,
    "expose_unavailable_models": false
  },
  "control": {
    "socket_path": "${XDG_RUNTIME_DIR}/asmflow/control.sock",
    "mode": "0600",
    "frame_max_bytes": 1048576
  },
  "storage": {
    "database_path": "${XDG_STATE_HOME}/asmflow/asmflow.db",
    "journal_mode": "wal",
    "busy_timeout_ms": 3000,
    "request_metadata_retention_days": 30,
    "store_payloads": false
  },
  "logging": {
    "level": "info",
    "format": "jsonl",
    "destination": "stderr",
    "include_request_metadata": true,
    "include_payloads": false,
    "redact_headers": [
      "authorization",
      "proxy-authorization",
      "cookie",
      "set-cookie"
    ]
  },
  "limits": {
    "max_active_requests": 128,
    "max_queued_requests": 256,
    "json_max_depth": 64,
    "json_string_max_bytes": 4194304,
    "sse_event_max_bytes": 1048576,
    "mcp_frame_max_bytes": 4194304,
    "stderr_line_max_bytes": 65536
  },
  "providers": [
    {
      "id": "local-ollama",
      "display_name": "Local Ollama",
      "adapter": "openai_chat",
      "base_url": "http://127.0.0.1:11434/v1",
      "auth": {
        "type": "none"
      },
      "enabled": true,
      "required": false,
      "max_concurrency": 4,
      "timeouts": {
        "connect_ms": 2000,
        "request_ms": 120000,
        "idle_stream_ms": 30000
      },
      "capabilities": {
        "responses": false,
        "chat_completions": true,
        "streaming": true,
        "tools": true,
        "vision": false,
        "json_schema": false
      },
      "health": {
        "path": "/models",
        "interval_ms": 10000,
        "failure_threshold": 3,
        "success_threshold": 2,
        "open_cooldown_ms": 30000
      },
      "api_key": "not-a-real-key"
    }
  ],
  "routes": [
    {
      "id": "general-route",
      "model_alias": "general",
      "enabled": true,
      "endpoint_families": [
        "chat_completions"
      ],
      "policy": "priority",
      "fallback": {
        "enabled": false,
        "max_attempts": 1,
        "retryable": []
      },
      "targets": [
        {
          "provider_id": "local-ollama",
          "upstream_model": "qwen-example",
          "priority": 10,
          "weight": 1
        }
      ]
    }
  ],
  "mcp_servers": []
}
